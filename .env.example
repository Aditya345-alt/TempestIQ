# ======================================================================
# TEMPESTIQ PLATFORM ENVIRONMENT CONFIGURATION
# ======================================================================

ENVIRONMENT=development
DEMO_MODE=true

# Server
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./tempestiq.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/tempestiq

# Security
SECRET_KEY=tempestiq-super-secret-production-key-change-in-prod

# External Sensor Data Providers (Optional - fallback to simulation when empty)
WEATHER_API_KEY=
RADAR_API_URL=
SATELLITE_API_URL=
LIGHTNING_API_URL=
